#!/bin/sh
# Guard protected refs and advance Work Lane leases through public ETHOS CAS.
set -eu

phase=$1
case "$phase" in
  prepared|committed) ;;
  *) exit 0 ;;
esac

root=$(git rev-parse --show-toplevel)
while read -r old_head new_head ref; do
  case "$ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  if ! report=$(ethos hook ref-transaction "$ref" "$old_head" "$new_head" \
    --phase "$phase" --root "$root" --json); then
    printf '%s\n' "$report" >&2
    exit 1
  fi
done
