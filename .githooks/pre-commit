#!/usr/bin/env bash
# Admit staged tracked writes through the public ETHOS command plane.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
staged=()
while IFS= read -r path; do
  staged+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMRTD)

((${#staged[@]})) || exit 0
if ! report=$(ethos hook admit pre-tool "${staged[@]}" \
  --root "$root" --editor-root "$root" --require-editor-root --json); then
  printf '%s\n' "$report" >&2
  exit 1
fi
